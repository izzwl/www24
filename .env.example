# Database Auth Portal NTP (portalpy)
DB_HOST=127.0.0.1
DB_PORT=3806
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=portalpy

# Session Secret Key
SESSION_SECRET=your_random_secret_key

# Server Port & Host
PORT=3024
HOST=0.0.0.0

# Optional: Custom Node Binary Path for PM2 (e.g. /home/user/.nvm/versions/node/v24.19.0/bin/node)
# Leave empty to automatically use 'node' from system PATH
NODE_INTERPRETER=
